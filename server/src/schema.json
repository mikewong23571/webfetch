{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "prompt": { "type": "string" },
    "options": {
      "type": "object",
      "properties": {
        "render_strategy": {
          "type": "string",
          "enum": ["markdown", "html", "playwright"],
          "default": "markdown"
        },
        "max_tokens": { "type": "integer", "maximum": 32768, "default": 32768 },
        "wait_until": {
          "type": "string",
          "enum": ["networkidle", "load"],
          "default": "load"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["url"],
  "additionalProperties": false
}
